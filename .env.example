# Copy these into the Vercel project settings (Settings > Environment Variables).

# Password for the admin panel at /admin. Choose a long one.
ADMIN_PASSWORD=
# Any long random text. Signs the admin login cookie.
SESSION_SECRET=

# WhatsApp number for orders, country code first, digits only.
NEXT_PUBLIC_WHATSAPP_NUMBER=919505840425

# Your website address once you know it, for example https://aarifa-flowers.vercel.app
# Adds a link to the garland inside each WhatsApp order message.
NEXT_PUBLIC_SITE_URL=

# Supabase keys. Needed so admin changes and photos are saved when the site is online.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI suggestions for garland name and description (optional).
# Get a key at console.anthropic.com. Photos are sent to Anthropic when you press the suggest button.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5. A cheaper choice is claude-sonnet-5.
ANTHROPIC_MODEL=
