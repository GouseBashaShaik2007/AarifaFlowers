{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Worker name. It must match the name of the project in the Cloudflare dashboard.
  "name": "aarifaflowers",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // The Worker calls itself through this binding. "service" must equal "name" above.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "aarifaflowers"
    }
  ]
}
